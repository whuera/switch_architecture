<script>
(function () {
    var canvas = document.getElementById('bg-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');

    var W, H, particles;

    var MAX_DIST_SQ = 18000; // ~134px conexion maxima
    var COLORS = ['#ffffff', '#6366f1', '#ffffff', '#3b82f6', '#ffffff', '#818cf8'];

    function Particle() {
        this.x  = Math.random() * W;
        this.y  = Math.random() * H;
        this.vx = (Math.random() - 0.5) * 0.55;
        this.vy = (Math.random() - 0.5) * 0.55;
        this.r  = Math.random() * 1.4 + 0.8;
        this.color = COLORS[Math.floor(Math.random() * COLORS.length)];
        this.alpha = Math.random() * 0.4 + 0.4;
    }

    Particle.prototype.update = function () {
        this.x += this.vx;
        this.y += this.vy;
        if (this.x < 0 || this.x > W) this.vx = -this.vx;
        if (this.y < 0 || this.y > H) this.vy = -this.vy;
    };

    Particle.prototype.draw = function () {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
        ctx.fillStyle = this.color;
        ctx.globalAlpha = this.alpha;
        ctx.fill();
        ctx.globalAlpha = 1;
    };

    function init() {
        W = canvas.width  = window.innerWidth;
        H = canvas.height = window.innerHeight;
        var count = Math.min(Math.floor((W * H) / 20000), 66);
        particles = [];
        for (var i = 0; i < count; i++) particles.push(new Particle());
    }

    function drawLines() {
        for (var i = 0; i < particles.length; i++) {
            for (var j = i + 1; j < particles.length; j++) {
                var dx = particles[i].x - particles[j].x;
                var dy = particles[i].y - particles[j].y;
                var dSq = dx * dx + dy * dy;
                if (dSq < MAX_DIST_SQ) {
                    var alpha = (1 - dSq / MAX_DIST_SQ) * 0.28;
                    ctx.beginPath();
                    ctx.strokeStyle = 'rgba(99,102,241,' + alpha + ')';
                    ctx.lineWidth = 0.7;
                    ctx.moveTo(particles[i].x, particles[i].y);
                    ctx.lineTo(particles[j].x, particles[j].y);
                    ctx.stroke();
                }
            }
        }
    }

    function animate() {
        ctx.clearRect(0, 0, W, H);
        for (var i = 0; i < particles.length; i++) {
            particles[i].update();
            particles[i].draw();
        }
        drawLines();
        requestAnimationFrame(animate);
    }

    init();
    animate();

    window.addEventListener('resize', init);
})();

// ===== APP LOGIC =====
document.addEventListener('DOMContentLoaded', function() {

    // Year
    var yearEl = document.getElementById('year');
    if (yearEl) yearEl.textContent = new Date().getFullYear();

    // ===== NAVIGATION =====
    var navLinks = document.querySelectorAll('[data-section]');
    var sections = {
        inicio:      document.getElementById('inicio-section'),
        servicios:   document.getElementById('servicios-section'),
        plataforma:  document.getElementById('plataforma-section'),
        simuladores: document.getElementById('simuladores-section'),
        modulos:     document.getElementById('modulos-section')
    };

    function showSection(name) {
        Object.keys(sections).forEach(function(key) {
            var el = sections[key];
            if (!el) return;
            if (key === name) {
                el.classList.remove('hidden');
                el.classList.add('fade-in');
                setTimeout(function() { el.classList.remove('fade-in'); }, 400);
            } else {
                el.classList.add('hidden');
            }
        });
        navLinks.forEach(function(link) {
            link.classList.toggle('active', link.dataset.section === name);
        });
    }

    navLinks.forEach(function(link) {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            showSection(link.dataset.section);
        });
    });

    // ===== MOBILE MENU =====
    var mobileMenuBtn  = document.getElementById('mobile-menu-btn');
    var mobileMenu     = document.getElementById('mobile-menu');

    function closeMobileMenu() {
        if (!mobileMenu || !mobileMenuBtn) return;
        mobileMenu.classList.remove('is-open');
        mobileMenuBtn.classList.remove('is-open');
        mobileMenuBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.setAttribute('aria-hidden', 'true');
    }

    if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            var isOpen = mobileMenu.classList.toggle('is-open');
            mobileMenuBtn.classList.toggle('is-open', isOpen);
            mobileMenuBtn.setAttribute('aria-expanded', String(isOpen));
            mobileMenu.setAttribute('aria-hidden', String(!isOpen));
        });

        // Close when a mobile nav link is clicked
        mobileMenu.querySelectorAll('.mobile-nav-link[data-section]').forEach(function(link) {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                showSection(link.dataset.section);
                closeMobileMenu();
            });
        });

        // Close when clicking outside the menu
        document.addEventListener('click', function(e) {
            if (!mobileMenu.contains(e.target) && e.target !== mobileMenuBtn) {
                closeMobileMenu();
            }
        });
    }

    // Mobile AI button → same action as desktop
    var mobileConsultameBtn = document.getElementById('mobile-consultame-btn');
    if (mobileConsultameBtn) {
        mobileConsultameBtn.addEventListener('click', function() {
            closeMobileMenu();
            document.getElementById('consultame-btn').click();
        });
    }

    var coreLink = document.getElementById('core-modules-link');
    if (coreLink) coreLink.addEventListener('click', function() { showSection('modulos'); });

    // ===== MODALS =====
    var modalConfigs = [
        { btnId: 'validacion-btn',   modalId: 'validacion-modal' },
        { btnId: 'enrutamiento-btn', modalId: 'enrutamiento-modal' },
        { btnId: 'autorizacion-btn', modalId: 'autorizacion-modal' },
        { btnId: 'proyectos-btn',    modalId: 'proyectos-modal' },
        { btnId: 'docs-btn',         modalId: 'docs-modal' },
        { btnId: 'journal-btn',      modalId: 'journal-modal' },
        { btnId: 'contact-btn-modal',modalId: 'contact-modal' },
        { btnId: 'prices-btn',       modalId: 'prices-modal' },
        { btnId: 'formacion-btn',    modalId: 'formacion-modal' }
    ];

    function openModal(id) {
        var m = document.getElementById(id);
        if (m) m.style.display = 'flex';
    }

    function closeModal(id) {
        var m = document.getElementById(id);
        if (!m) return;
        m.style.display = 'none';
        if (id === 'contact-modal') {
            var f = document.getElementById('contact-form');
            var r = document.getElementById('form-response');
            if (f) f.reset();
            if (r) { r.className = 'form-response'; r.textContent = ''; }
        }
    }

    // Expertos modal
    var expertosBtn = document.getElementById('expertos-btn');
    var expertosModal = document.getElementById('expertos-modal');
    if (expertosBtn && expertosModal) {
        expertosBtn.addEventListener('click', function() { expertosModal.style.display = 'flex'; });
        expertosModal.querySelectorAll('.close-modal').forEach(function(el) {
            el.addEventListener('click', function() { expertosModal.style.display = 'none'; });
        });
        expertosModal.addEventListener('click', function(e) {
            if (e.target === expertosModal) expertosModal.style.display = 'none';
        });
    }

    modalConfigs.forEach(function(cfg) {
        var btn   = document.getElementById(cfg.btnId);
        var modal = document.getElementById(cfg.modalId);
        if (!btn || !modal) return;

        btn.addEventListener('click', function(e) { e.preventDefault(); openModal(cfg.modalId); });
        btn.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(cfg.modalId); } });

        modal.querySelectorAll('.close-modal').forEach(function(el) {
            el.addEventListener('click', function() { closeModal(cfg.modalId); });
        });

        modal.addEventListener('click', function(e) {
            if (e.target === modal) closeModal(cfg.modalId);
        });
    });

    // ===== DOCS VIEWER (PDF.js canvas) =====
    var docsLoaded = false;
    var docsModalEl = document.getElementById('docs-modal');
    if (docsModalEl) {
        docsModalEl.addEventListener('contextmenu', function(e) { e.preventDefault(); });
    }

    if (window.pdfjsLib) {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
    }

    function renderPdf(url) {
        var pagesContainer = document.getElementById('docs-pages');
        var wrapper = document.getElementById('docs-canvas-wrapper');
        var placeholder = document.getElementById('docs-placeholder');
        pagesContainer.innerHTML = '<div style="text-align:center;padding:40px;color:#8b949e;">Cargando documento...</div>';
        placeholder.style.display = 'none';
        wrapper.style.display = 'block';

        pdfjsLib.getDocument(url).promise.then(function(pdf) {
            pagesContainer.innerHTML = '';
            var wrapperWidth = wrapper.clientWidth - 40;
            for (var i = 1; i <= pdf.numPages; i++) {
                (function(pageNum) {
                    pdf.getPage(pageNum).then(function(page) {
                        var baseViewport = page.getViewport({ scale: 1 });
                        var scale = wrapperWidth / baseViewport.width;
                        if (scale > 2) scale = 2;
                        var viewport = page.getViewport({ scale: scale });
                        var canvas = document.createElement('canvas');
                        canvas.className = 'docs-page-canvas';
                        canvas.width = viewport.width;
                        canvas.height = viewport.height;
                        canvas.style.userSelect = 'none';
                        canvas.style.webkitUserSelect = 'none';
                        canvas.oncontextmenu = function(e) { e.preventDefault(); };
                        // Insert in order
                        var inserted = false;
                        var existing = pagesContainer.querySelectorAll('.docs-page-canvas');
                        for (var j = 0; j < existing.length; j++) {
                            if (parseInt(existing[j].getAttribute('data-page')) > pageNum) {
                                pagesContainer.insertBefore(canvas, existing[j]);
                                inserted = true;
                                break;
                            }
                        }
                        if (!inserted) pagesContainer.appendChild(canvas);
                        canvas.setAttribute('data-page', pageNum);
                        page.render({ canvasContext: canvas.getContext('2d'), viewport: viewport });
                    });
                })(i);
            }
        }).catch(function(err) {
            pagesContainer.innerHTML = '<div style="text-align:center;padding:40px;color:#f87171;">Error al cargar el documento.</div>';
            console.error('PDF render error:', err);
        });
    }

    var docsContactBtn = document.getElementById('docs-contact-btn');
    if (docsContactBtn) {
        docsContactBtn.addEventListener('click', function(e) {
            e.preventDefault();
            closeModal('docs-modal');
            setTimeout(function() { openModal('contact-modal'); }, 200);
        });
    }

    var docsBtn = document.getElementById('docs-btn');
    if (docsBtn) {
        docsBtn.addEventListener('click', function() {
            if (!docsLoaded) {
                fetch('/api/docs')
                    .then(function(r) { return r.json(); })
                    .then(function(res) {
                        if (res.success) {
                            var list = document.getElementById('docs-list');
                            list.innerHTML = '';
                            res.data.forEach(function(doc) {
                                var li = document.createElement('li');
                                li.className = 'docs-list-item';
                                li.textContent = doc.name;
                                li.setAttribute('data-file', doc.filename);
                                li.addEventListener('click', function() {
                                    document.querySelectorAll('.docs-list-item').forEach(function(el) { el.classList.remove('active'); });
                                    li.classList.add('active');
                                    renderPdf('/docs/' + encodeURIComponent(doc.filename));
                                });
                                list.appendChild(li);
                            });
                            docsLoaded = true;
                            var first = list.querySelector('.docs-list-item');
                            if (first) first.click();
                        }
                    })
                    .catch(function(err) { console.error('Error loading docs:', err); });
            }
        });
    }

    // ===== EXT CARDS → PRICES MODAL WITH HIGHLIGHT =====
    function clearPriceHighlights() {
        document.querySelectorAll('.price-node').forEach(function(n) {
            n.classList.remove('price-node--active');
        });
    }

    document.querySelectorAll('.ext-price-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            clearPriceHighlights();
            openModal('prices-modal');
            var nodeKey = btn.getAttribute('data-price-node');
            var target = document.getElementById('price-node-' + nodeKey);
            if (target) {
                target.classList.add('price-node--active');
                setTimeout(function() { target.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 150);
            }
        });
    });

    // Reset highlights on close/backdrop
    var pricesModal = document.getElementById('prices-modal');
    if (pricesModal) {
        pricesModal.addEventListener('click', function(e) {
            if (e.target === pricesModal) clearPriceHighlights();
        });
    }

    // ===== PRICES → CONTACT =====
    var contactFromPrices = document.getElementById('contact-from-prices');
    if (contactFromPrices) {
        contactFromPrices.addEventListener('click', function(e) {
            e.preventDefault();
            closeModal('prices-modal');
            openModal('contact-modal');
        });
    }

    // ===== CHATBOT =====
    var chatbotModal    = document.getElementById('chatbot-modal');
    var consultameBtn   = document.getElementById('consultame-btn');
    var closeChatbot    = document.getElementById('close-chatbot');
    var chatInput       = document.getElementById('chat-input');
    var sendChat        = document.getElementById('send-chat');
    var chatMessages    = document.getElementById('chat-messages');
    var iaQueryCounter  = document.getElementById('ia-query-counter');
    var iaQueriesEl     = document.getElementById('ia-queries-remaining');

    // Gate overlays
    var iaGateOverlay     = document.getElementById('ia-gate-overlay');
    var iaOtpOverlay      = document.getElementById('ia-otp-overlay');
    var iaExhaustedOverlay= document.getElementById('ia-exhausted-overlay');
    var iaGateForm        = document.getElementById('ia-gate-form');
    var iaGateSubmit      = document.getElementById('ia-gate-submit');
    var iaGateError       = document.getElementById('ia-gate-error');
    var iaOtpDigits       = document.querySelectorAll('.ia-otp-digit');
    var iaOtpVerifyBtn    = document.getElementById('ia-otp-verify-btn');
    var iaOtpError        = document.getElementById('ia-otp-error');
    var iaOtpMasked       = document.getElementById('ia-otp-masked');
    var iaResendBtn       = document.getElementById('ia-resend-btn');
    var iaResendTimer     = document.getElementById('ia-resend-timer');

    var iaPendingEmail    = '';
    var iaChatState       = 'UNVERIFIED'; // UNVERIFIED | ACTIVE | EXHAUSTED
    var iaQueriesRemaining= 0;

    function iaShowOverlay(which) {
        iaGateOverlay.classList.add('ia-hidden');
        iaOtpOverlay.classList.add('ia-hidden');
        iaExhaustedOverlay.classList.add('ia-hidden');
        if (which) document.getElementById('ia-' + which + '-overlay').classList.remove('ia-hidden');
    }

    function iaOpenChat() {
        if (chatbotModal) chatbotModal.style.display = 'flex';
        if (iaQueryCounter) { iaQueryCounter.style.display = ''; iaQueriesEl.textContent = iaQueriesRemaining; }
    }

    if (consultameBtn) {
        consultameBtn.addEventListener('click', async function(e) {
            e.preventDefault();
            try {
                var res = await fetch('/api/chat/session');
                var data = await res.json();
                iaChatState = data.status;
                iaQueriesRemaining = data.queriesRemaining;
            } catch (_) { iaChatState = 'UNVERIFIED'; }

            if (iaChatState === 'ACTIVE') {
                iaOpenChat();
            } else if (iaChatState === 'EXHAUSTED') {
                iaShowOverlay('exhausted');
            } else {
                iaShowOverlay('gate');
            }
        });
    }

    if (closeChatbot) {
        closeChatbot.addEventListener('click', function() {
            if (chatbotModal) chatbotModal.style.display = 'none';
        });
    }
    if (chatbotModal) {
        chatbotModal.addEventListener('click', function(e) {
            if (e.target === chatbotModal) chatbotModal.style.display = 'none';
        });
    }

    var iaGateClose = document.getElementById('ia-gate-close');
    var iaOtpClose  = document.getElementById('ia-otp-close');
    if (iaGateClose) iaGateClose.addEventListener('click', function() { iaShowOverlay(null); });
    if (iaOtpClose)  iaOtpClose.addEventListener('click',  function() { iaShowOverlay(null); });

    function addMsg(text, type) {
        var div = document.createElement('div');
        div.className = 'chat-msg ' + type;
        div.textContent = text;
        chatMessages.appendChild(div);
        chatMessages.scrollTop = chatMessages.scrollHeight;
        return div;
    }

    function addTyping() {
        var div = document.createElement('div');
        div.className = 'chat-msg typing';
        div.innerHTML = '<div class="typing-dots"><span></span><span></span><span></span></div>';
        chatMessages.appendChild(div);
        chatMessages.scrollTop = chatMessages.scrollHeight;
        return div;
    }

    async function sendMessage() {
        var text = chatInput.value.trim();
        if (!text) return;
        if (iaChatState === 'EXHAUSTED') { chatbotModal.style.display = 'none'; iaShowOverlay('exhausted'); return; }

        addMsg(text, 'user');
        chatInput.value = '';
        chatInput.disabled = true;
        sendChat.disabled = true;
        var typing = addTyping();
        try {
            var res = await fetch('/api/chat/query', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ query: text })
            });
            chatMessages.removeChild(typing);
            var data = await res.json();

            if (data.requiresVerification) {
                chatbotModal.style.display = 'none';
                iaShowOverlay('gate');
                return;
            }
            if (data.exhausted && !data.success) {
                iaChatState = 'EXHAUSTED';
                chatbotModal.style.display = 'none';
                iaShowOverlay('exhausted');
                return;
            }
            if (!data.success) {
                addMsg(data.error || 'Error de conexión. Intenta nuevamente.', 'error');
                return;
            }

            // Render — split soft CTA if present
            var rawResponse = data.response || '';
            var ctaDelimiter = '\n\n---\n';
            var ctaIdx = rawResponse.indexOf(ctaDelimiter);
            if (ctaIdx !== -1) {
                var msgDiv = document.createElement('div');
                msgDiv.className = 'chat-msg assistant';
                msgDiv.appendChild(document.createTextNode(rawResponse.substring(0, ctaIdx)));
                var ctaDiv = document.createElement('div');
                ctaDiv.className = 'ia-cta-soft';
                ctaDiv.textContent = rawResponse.substring(ctaIdx + ctaDelimiter.length);
                msgDiv.appendChild(ctaDiv);
                chatMessages.appendChild(msgDiv);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            } else {
                addMsg(rawResponse, 'assistant');
            }

            iaQueriesRemaining = data.queriesRemaining;
            if (iaQueriesEl) iaQueriesEl.textContent = iaQueriesRemaining;

            if (data.exhausted) {
                iaChatState = 'EXHAUSTED';
                setTimeout(function() { chatbotModal.style.display = 'none'; iaShowOverlay('exhausted'); }, 1200);
            }
        } catch (err) {
            if (typing.parentNode) chatMessages.removeChild(typing);
            addMsg('Error de conexión. Intenta nuevamente.', 'error');
        } finally {
            chatInput.disabled = false;
            sendChat.disabled = false;
            chatInput.focus();
        }
    }

    if (sendChat)  sendChat.addEventListener('click', sendMessage);
    if (chatInput) chatInput.addEventListener('keypress', function(e) { if (e.key === 'Enter') sendMessage(); });

    // ===== GATE FORM =====
    if (iaGateForm) {
        iaGateForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            iaGateError.textContent = '';
            iaGateSubmit.disabled = true;
            iaGateSubmit.textContent = 'Enviando…';
            var name    = document.getElementById('ia-name').value.trim();
            var email   = document.getElementById('ia-email').value.trim();
            var company = document.getElementById('ia-company').value.trim();
            var phone   = document.getElementById('ia-phone').value.trim();
            var consent = document.getElementById('ia-consent').checked;
            var hp      = document.getElementById('ia-hp').value;
            try {
                var res = await fetch('/api/leads/register', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, email, company, phone, dataConsent: consent, _hp: hp })
                });
                var data = await res.json();
                if (data.success) {
                    iaPendingEmail = email;
                    iaOtpMasked.textContent = data.maskedEmail;
                    iaShowOverlay('otp');
                    iaOtpDigits[0].focus();
                    iaStartResendCooldown(60);
                } else {
                    iaGateError.textContent = data.error || 'Error al registrar. Intenta nuevamente.';
                }
            } catch (_) { iaGateError.textContent = 'Error de conexión.'; }
            finally { iaGateSubmit.disabled = false; iaGateSubmit.textContent = 'Continuar →'; }
        });
    }

    // ===== OTP =====
    iaOtpDigits.forEach(function(input, idx) {
        input.addEventListener('input', function() {
            var val = input.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            input.value = val ? val[0] : '';
            if (val && idx < iaOtpDigits.length - 1) iaOtpDigits[idx + 1].focus();
        });
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Backspace' && !input.value && idx > 0) iaOtpDigits[idx - 1].focus();
            if (e.key === 'Enter') iaVerifyOTP();
        });
        input.addEventListener('paste', function(e) {
            e.preventDefault();
            var paste = (e.clipboardData || window.clipboardData).getData('text').toUpperCase().replace(/\s/g, '');
            iaOtpDigits.forEach(function(d, i) { d.value = paste[i] || ''; });
            iaOtpDigits[Math.min(paste.length, iaOtpDigits.length - 1)].focus();
        });
    });

    async function iaVerifyOTP() {
        iaOtpError.textContent = '';
        var code = Array.from(iaOtpDigits).map(function(d) { return d.value; }).join('');
        if (code.length < 6) { iaOtpError.textContent = 'Ingresa el código de 6 caracteres.'; return; }
        iaOtpVerifyBtn.disabled = true; iaOtpVerifyBtn.textContent = 'Verificando…';
        try {
            var res = await fetch('/api/leads/verify-otp', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: iaPendingEmail, code: code })
            });
            var data = await res.json();
            if (data.success) {
                iaChatState = 'ACTIVE';
                iaQueriesRemaining = data.queriesRemaining;
                iaShowOverlay(null);
                iaOpenChat();
            } else {
                iaOtpError.textContent = data.error || 'Código inválido o expirado.';
                iaOtpDigits.forEach(function(d) { d.value = ''; });
                iaOtpDigits[0].focus();
            }
        } catch (_) { iaOtpError.textContent = 'Error de conexión.'; }
        finally { iaOtpVerifyBtn.disabled = false; iaOtpVerifyBtn.textContent = 'Verificar'; }
    }
    if (iaOtpVerifyBtn) iaOtpVerifyBtn.addEventListener('click', iaVerifyOTP);

    // ===== RESEND =====
    var iaResendInterval = null;
    function iaStartResendCooldown(secs) {
        iaResendBtn.disabled = true; iaResendTimer.style.display = 'inline';
        var rem = secs;
        iaResendTimer.textContent = ' (' + rem + 's)';
        iaResendInterval = setInterval(function() {
            rem--;
            if (rem <= 0) { clearInterval(iaResendInterval); iaResendBtn.disabled = false; iaResendTimer.style.display = 'none'; }
            else iaResendTimer.textContent = ' (' + rem + 's)';
        }, 1000);
    }
    if (iaResendBtn) {
        iaResendBtn.addEventListener('click', async function() {
            if (!iaPendingEmail) return;
            iaResendBtn.disabled = true;
            try {
                var res = await fetch('/api/leads/resend-code', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: iaPendingEmail })
                });
                var data = await res.json();
                if (data.success) { iaStartResendCooldown(60); iaOtpError.textContent = ''; }
                else if (data.waitSeconds) { iaStartResendCooldown(data.waitSeconds); }
                else { iaOtpError.textContent = data.error || 'No se pudo reenviar.'; iaResendBtn.disabled = false; }
            } catch (_) { iaOtpError.textContent = 'Error de conexión.'; iaResendBtn.disabled = false; }
        });
    }

    // ===== FORMACION CTA → CONTACT MODAL =====
    var formacionCta = document.getElementById('formacion-contact-cta');
    if (formacionCta) {
        formacionCta.addEventListener('click', function() {
            closeModal('formacion-modal');
            document.getElementById('form-source').value = 'formacion';
            var commentField = document.querySelector('#contact-form textarea[name="comment"]');
            if (commentField && !commentField.value.trim()) {
                commentField.value = 'Estoy interesado/a en sus programas de formación especializada (BASE24-eps, UPF, Java/Spring Boot, Python, IA/LLM).';
            }
            openModal('contact-modal');
        });
    }

    // ===== CONTACT FORM =====
    var contactForm = document.getElementById('contact-form');
    var submitBtn   = document.getElementById('submit-contact');
    var formResp    = document.getElementById('form-response');

    if (contactForm) {
        contactForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            submitBtn.disabled = true;
            submitBtn.classList.add('loading');
            submitBtn.textContent = 'Enviando...';
            formResp.textContent = '';
            formResp.className = 'form-response';

            var fd = new FormData(contactForm);
            var parts = fd.get('name').trim().split(/\s+/);
            var payload = {
                firstName:   parts[0] || '',
                lastName:    parts.slice(1).join(' ') || ' ',
                email:       fd.get('email'),
                documentId:  fd.get('documentId'),
                phoneNumber: fd.get('phone'),
                comment:     fd.get('comment'),
                appsource:   'web-mobilpymes',
                canal:       'web',
                type:        'cliente-prospecto'
            };

            try {
                // Guardar en BD externa
                var resDB = fetch('https://shopping-cart-gateway.whuera.workers.dev/api/customer/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                // Enviar correos via Resend
                var resMail = fetch('/api/contact', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: fd.get('name'),
                        email: fd.get('email'),
                        documentId: fd.get('documentId'),
                        phone: fd.get('phone'),
                        comment: fd.get('comment'),
                        source: fd.get('source') || ''
                    })
                });

                var results = await Promise.allSettled([resDB, resMail]);
                var anyOk = results.some(function(r) { return r.status === 'fulfilled' && r.value && r.value.ok; });

                if (anyOk) {
                    formResp.textContent = 'Mensaje enviado con éxito! Revisa tu correo.';
                    formResp.classList.add('success');
                    contactForm.reset();
                    document.getElementById('form-source').value = '';
                } else { throw new Error(); }
            } catch {
                formResp.textContent = 'Servicio no disponible por el momento';
                formResp.classList.add('error');
            } finally {
                submitBtn.disabled = false;
                submitBtn.classList.remove('loading');
                submitBtn.textContent = 'Enviar Mensaje';
            }
        });
    }
});

// ===== WORLD MAP (D3 + Natural Earth) =====
window.addEventListener('load', function() {
    if (typeof d3 === 'undefined' || typeof topojson === 'undefined') return;
    renderWorldMap();
});

async function renderWorldMap() {
    var wrap = document.getElementById('world-map-wrap');
    if (!wrap) return;

    var W = wrap.offsetWidth || wrap.getBoundingClientRect().width || 480;
    var H = Math.round(W * 0.5);

    var svg = d3.select(wrap).append('svg')
        .attr('viewBox', '0 0 ' + W + ' ' + H)
        .style('width', '100%').style('height', 'auto').style('display', 'block');

    svg.append('rect').attr('width', W).attr('height', H).attr('fill', '#060d1a');

    var projection = d3.geoMercator()
        .scale(W / (2 * Math.PI) * 0.96)
        .translate([W / 2, H / 2 + H * 0.09]);

    var pathGen = d3.geoPath().projection(projection);

    // Graticule grid lines every 30°
    var graticule = d3.geoGraticule().step([30, 30]);
    svg.append('path').datum(graticule())
        .attr('d', pathGen).attr('fill', 'none')
        .attr('stroke', 'rgba(255,255,255,0.055)').attr('stroke-width', 0.5);

    // Load Natural Earth 110m world data
    var world;
    try {
        world = await d3.json('/countries-110m.json');
    } catch(e) {
        console.error('World map data failed:', e);
        return;
    }

    var countriesGeo = topojson.feature(world, world.objects.countries);
    var bordersGeo   = topojson.mesh(world, world.objects.countries, function(a, b) { return a !== b; });

    var hl = {
        '218': { fill: 'rgba(52,211,153,0.48)', stroke: 'rgba(52,211,153,0.78)' }, // Ecuador
        '170': { fill: 'rgba(52,211,153,0.45)', stroke: 'rgba(52,211,153,0.72)' }, // Colombia
        '591': { fill: 'rgba(52,211,153,0.42)', stroke: 'rgba(52,211,153,0.68)' }, // Panama
        '188': { fill: 'rgba(52,211,153,0.42)', stroke: 'rgba(52,211,153,0.68)' }, // Costa Rica
        '152': { fill: 'rgba(52,211,153,0.40)', stroke: 'rgba(52,211,153,0.65)' }, // Chile
        '32':  { fill: 'rgba(234,179,8,0.40)',  stroke: 'rgba(234,179,8,0.68)'  }, // Argentina
        '724': { fill: 'rgba(99,102,241,0.52)', stroke: 'rgba(99,102,241,0.88)' }, // Spain
    };

    svg.selectAll('path.c')
        .data(countriesGeo.features).join('path').attr('class', 'c')
        .attr('d', pathGen)
        .attr('fill',   function(d) { var h = hl[String(d.id)]; return h ? h.fill   : '#131e2e'; })
        .attr('stroke', function(d) { var h = hl[String(d.id)]; return h ? h.stroke : 'rgba(148,180,212,0.2)'; })
        .attr('stroke-width', function(d) { return hl[String(d.id)] ? 0.9 : 0.4; });

    svg.append('path').datum(bordersGeo).attr('d', pathGen)
        .attr('fill', 'none').attr('stroke', 'rgba(148,180,212,0.18)').attr('stroke-width', 0.4);

    // Glow filter
    var defs = svg.append('defs');
    var flt = defs.append('filter').attr('id', 'mglow');
    flt.append('feGaussianBlur').attr('stdDeviation', '3.5').attr('result', 'b');
    var mrg = flt.append('feMerge');
    mrg.append('feMergeNode').attr('in', 'b');
    mrg.append('feMergeNode').attr('in', 'SourceGraphic');

    // Capital-city marker positions
    var markers = [
        { lon: -78.47, lat: -0.23,  color: '#6366f1', large: true  }, // Ecuador
        { lon: -74.07, lat:  4.71,  color: '#34d399', large: false  }, // Colombia
        { lon: -79.52, lat:  8.99,  color: '#34d399', large: false  }, // Panama
        { lon: -84.09, lat:  9.93,  color: '#34d399', large: false  }, // Costa Rica
        { lon: -70.67, lat: -33.45, color: '#34d399', large: false  }, // Chile
        { lon: -58.38, lat: -34.60, color: '#eab308', large: false  }, // Argentina
        { lon:  -3.70, lat:  40.42, color: '#6366f1', large: true   }, // Spain
    ];

    // Connection lines (behind markers)
    function line(a, b, col) {
        var p1 = projection([a.lon, a.lat]);
        var p2 = projection([b.lon, b.lat]);
        if (!p1 || !p2) return;
        svg.append('line')
            .attr('x1', p1[0]).attr('y1', p1[1]).attr('x2', p2[0]).attr('y2', p2[1])
            .attr('stroke', col).attr('stroke-width', 0.8)
            .attr('stroke-dasharray', '3,3').attr('opacity', 0.32);
    }
    line(markers[0], markers[1], '#6366f1');
    line(markers[1], markers[2], '#34d399');
    line(markers[2], markers[3], '#34d399');
    line(markers[0], markers[4], '#34d399');
    line(markers[4], markers[5], '#eab308');

    // Arc Ecuador → Spain
    var ep = projection([markers[0].lon, markers[0].lat]);
    var sp = projection([markers[6].lon, markers[6].lat]);
    if (ep && sp) {
        svg.append('path')
            .attr('d', 'M'+ep[0]+','+ep[1]+' Q'+((ep[0]+sp[0])/2)+','+(Math.min(ep[1],sp[1])-H*0.22)+' '+sp[0]+','+sp[1])
            .attr('fill', 'none').attr('stroke', '#6366f1')
            .attr('stroke-width', 0.8).attr('stroke-dasharray', '4,4').attr('opacity', 0.22);
    }

    // Markers
    var mG = svg.append('g');
    markers.forEach(function(m) {
        var pos = projection([m.lon, m.lat]);
        if (!pos) return;
        var x = pos[0], y = pos[1], g = mG.append('g');
        var outerR = m.large ? 22 : 14, dotR = m.large ? 7 : 5.5;

        g.append('circle').attr('cx',x).attr('cy',y).attr('r', outerR)
            .attr('fill','none').attr('stroke', m.color).attr('stroke-width',1.5)
            .attr('opacity',0.15).attr('class','map-pulse');
        if (m.large) {
            g.append('circle').attr('cx',x).attr('cy',y).attr('r',14)
                .attr('fill','none').attr('stroke',m.color).attr('stroke-width',1).attr('opacity',0.26);
        }
        g.append('circle').attr('cx',x).attr('cy',y).attr('r',dotR)
            .attr('fill',m.color).attr('opacity',0.92).attr('filter','url(#mglow)');
        g.append('circle').attr('cx',x).attr('cy',y).attr('r',dotR*0.38).attr('fill','white');
    });
}
</script>

