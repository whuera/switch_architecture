<script>
(function() {
  /* ── Login modal ── */
  var loginModal = document.getElementById('admin-login-modal');
  var adminBtn   = document.getElementById('admin-btn');
  var closeBtn   = document.getElementById('admin-modal-close');
  var form       = document.getElementById('admin-login-form');
  var submitBtn  = document.getElementById('admin-submit-btn');
  var errorEl    = document.getElementById('admin-login-error');

  function openLoginModal() {
    loginModal.style.display = 'flex';
    document.getElementById('admin-username').focus();
  }
  function closeLoginModal() {
    loginModal.style.display = 'none';
    errorEl.className = 'form-response';
    errorEl.textContent = '';
  }
  adminBtn.addEventListener('click', openLoginModal);
  closeBtn.addEventListener('click', closeLoginModal);
  loginModal.addEventListener('click', function(e) { if (e.target === loginModal) closeLoginModal(); });

  function showAdminError(msg) {
    errorEl.className = 'form-response error';
    errorEl.textContent = msg;
    submitBtn.disabled = false;
    submitBtn.textContent = 'Ingresar';
  }

  /* ── Dashboard panel ── */
  var panel     = document.getElementById('admin-panel');
  var apBody    = document.getElementById('ap-body');
  var apTotal   = document.getElementById('ap-total');
  var apStats   = document.getElementById('ap-stats');
  var apFilters = document.getElementById('ap-filters');
  var apSearch  = document.getElementById('ap-search');
  var apType    = document.getElementById('ap-type');
  var apCanal   = document.getElementById('ap-canal');
  var apApp     = document.getElementById('ap-appsource');
  var apReset   = document.getElementById('ap-reset');
  var apFcount  = document.getElementById('ap-fcount');
  var tableRows = [];

  function openPanel() {
    panel.style.display = 'block';
    document.body.style.overflow = 'hidden';
  }
  function closePanel() {
    panel.style.display = 'none';
    document.body.style.overflow = '';
  }

  document.getElementById('ap-close-btn').addEventListener('click', closePanel);

  document.getElementById('ap-logout-btn').addEventListener('click', async function() {
    await fetch('/api/admin/logout', { method: 'POST' });
    closePanel();
  });

  /* ── Filter logic ── */
  function matchNull(rowVal, filterVal) {
    if (filterVal === '__null__') return rowVal === '';
    if (filterVal === '') return true;
    return rowVal === filterVal;
  }
  function applyFilters() {
    var search = apSearch ? apSearch.value.toLowerCase().trim() : '';
    var type   = apType   ? apType.value   : '';
    var canal  = apCanal  ? apCanal.value  : '';
    var app    = apApp    ? apApp.value    : '';
    var visible = 0;
    tableRows.forEach(function(row) {
      var ok = (!search || (row.dataset.name||'').includes(search) || (row.dataset.email||'').includes(search) || (row.dataset.docid||'').includes(search))
        && matchNull(row.dataset.type||'', type)
        && matchNull(row.dataset.canal||'', canal)
        && matchNull(row.dataset.appsource||'', app);
      row.classList.toggle('ap-hidden', !ok);
      if (ok) visible++;
    });
    if (apFcount) apFcount.textContent = visible + ' de ' + tableRows.length + ' registros';
  }
  if (apSearch)  apSearch.addEventListener('input', applyFilters);
  if (apType)    apType.addEventListener('change', applyFilters);
  if (apCanal)   apCanal.addEventListener('change', applyFilters);
  if (apApp)     apApp.addEventListener('change', applyFilters);
  if (apReset)   apReset.addEventListener('click', function() {
    apSearch.value = ''; apType.value = ''; apCanal.value = ''; apApp.value = '';
    applyFilters();
  });

  /* ── Fill select ── */
  function fillSelect(sel, values) {
    sel.innerHTML = '<option value="">Todos</option>';
    values.forEach(function(v) {
      var o = document.createElement('option');
      o.value = v; o.textContent = v;
      sel.appendChild(o);
    });
    var nullOpt = document.createElement('option');
    nullOpt.value = '__null__'; nullOpt.textContent = '— sin valor —';
    sel.appendChild(nullOpt);
  }

  /* ── Render table ── */
  function esc(s) {
    return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function badge(val, cls) {
    if (!val) return '<span class="ap-badge ap-badge-null">—</span>';
    return '<span class="ap-badge ' + cls + '">' + esc(val) + '</span>';
  }
  function renderTable(customers) {
    if (!customers.length) {
      apBody.innerHTML = '<div class="ap-loading">No hay registros disponibles.</div>';
      return;
    }
    var html = '<div class="ap-table-inner"><table class="ap-table"><thead><tr>'
      + '<th>ID</th><th>Nombre</th><th>Email</th><th>Doc. ID</th><th>Teléfono</th>'
      + '<th>Type</th><th>Canal</th><th>App Source</th><th>Status</th><th>Comentario</th>'
      + '</tr></thead><tbody id="ap-tbody">';
    customers.forEach(function(c) {
      var name = [c.firstName, c.lastName].filter(Boolean).join(' ');
      html += '<tr'
        + ' data-name="' + esc((name).toLowerCase()) + '"'
        + ' data-email="' + esc((c.email||'').toLowerCase()) + '"'
        + ' data-docid="' + esc((c.documentId||'').toLowerCase()) + '"'
        + ' data-type="' + esc(c.type||'') + '"'
        + ' data-canal="' + esc(c.canal||'') + '"'
        + ' data-appsource="' + esc(c.appsource||'') + '">'
        + '<td class="ap-td-id">' + esc(c.id) + '</td>'
        + '<td>' + esc(name || '—') + '</td>'
        + '<td class="ap-td-muted">' + esc(c.email||'—') + '</td>'
        + '<td class="ap-td-muted">' + esc(c.documentId||'—') + '</td>'
        + '<td class="ap-td-muted">' + esc(c.phoneNumber||'—') + '</td>'
        + '<td>' + badge(c.type, 'ap-badge-type') + '</td>'
        + '<td>' + badge(c.canal, 'ap-badge-canal') + '</td>'
        + '<td>' + badge(c.appsource, 'ap-badge-app') + '</td>'
        + '<td class="ap-td-muted">' + esc(c.status||'—') + '</td>'
        + '<td class="ap-td-comment" title="' + esc(c.comment||'') + '">' + esc(c.comment||'—') + '</td>'
        + '</tr>';
    });
    html += '</tbody></table></div>';
    apBody.innerHTML = html;
    tableRows = Array.from(document.querySelectorAll('#ap-tbody tr'));
    applyFilters();
  }

  /* ── Load customers ── */
  async function loadDashboard() {
    openPanel();
    apBody.innerHTML = '<div class="ap-loading">Cargando datos…</div>';
    apFilters.style.display = 'none';
    try {
      var res  = await fetch('/api/admin/customers');
      var json = await res.json();
      if (!json.success) throw new Error(json.error || 'Error del servidor');
      var customers = json.data;
      apTotal.textContent = customers.length;

      var types     = [...new Set(customers.map(function(c){return c.type;}).filter(Boolean))].sort();
      var canales   = [...new Set(customers.map(function(c){return c.canal;}).filter(Boolean))].sort();
      var appsources = [...new Set(customers.map(function(c){return c.appsource;}).filter(Boolean))].sort();

      apStats.innerHTML =
        '<div class="ap-stat"><div class="ap-stat-label">Total</div><div class="ap-stat-value">' + customers.length + '</div></div>'
        + (types.length ? '<div class="ap-stat"><div class="ap-stat-label">Tipos</div><div class="ap-stat-value" style="color:#6366f1">' + types.length + '</div></div>' : '')
        + (canales.length ? '<div class="ap-stat"><div class="ap-stat-label">Canales</div><div class="ap-stat-value" style="color:#3b82f6">' + canales.length + '</div></div>' : '')
        + (appsources.length ? '<div class="ap-stat"><div class="ap-stat-label">App Sources</div><div class="ap-stat-value" style="color:#22c55e">' + appsources.length + '</div></div>' : '');

      fillSelect(apType, types);
      fillSelect(apCanal, canales);
      fillSelect(apApp, appsources);
      apFilters.style.display = 'flex';
      renderTable(customers);
    } catch(err) {
      apBody.innerHTML = '<div class="ap-error">Error al cargar datos: ' + err.message + '</div>';
    }
  }

  /* ── Login submit ── */
  async function doLogin() {
    submitBtn.disabled = true;
    submitBtn.textContent = 'Verificando...';
    errorEl.className = 'form-response';
    errorEl.textContent = '';
    try {
      var res  = await fetch('/api/admin/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          username: document.getElementById('admin-username').value,
          password: document.getElementById('admin-password').value
        })
      });
      var data = await res.json();
      if (data.success) {
        closeLoginModal();
        loadDashboard();
      } else {
        showAdminError(data.error || 'Credenciales incorrectas');
      }
    } catch(err) {
      showAdminError('Error de conexión: ' + (err.message || 'Intenta de nuevo'));
    }
  }
  submitBtn.addEventListener('click', doLogin);
  form.addEventListener('submit', function(e) { e.preventDefault(); doLogin(); });

  /* ── Auto-open si ya hay sesión activa ── */
  fetch('/api/admin/session').then(function(r){ return r.json(); }).then(function(d){
    if (d.valid) loadDashboard();
  });
})();
</script>
</body>
</html>
