                    <path d="M15 8L22 12V20L15 24L8 20V12L15 8Z" fill="rgba(14,165,233,0.35)"/>
                    <circle cx="15" cy="15" r="3" fill="#0ea5e9"/>
                    <circle cx="15" cy="15" r="1.2" fill="#fff"/>
                </svg>
            </div>
            <div class="brand-text">
                <span class="brand-title">B24-eps &amp; UPF</span>
                <span class="brand-sub">Consulting for Fintech</span>
            </div>
        </div>

        <nav class="navbar-nav">
            <a href="#" class="nav-link active" data-section="inicio" data-i18n="nav_inicio">Inicio</a>
            <a href="#" class="nav-link" data-section="servicios" data-i18n="nav_servicios">Servicios</a>
            <a href="#" class="nav-link" data-section="plataforma" data-i18n="nav_plataforma">Plataforma ACI</a>
            <a href="https://deepwiki.com/whuera/switch_architecture" class="nav-link" target="_blank" rel="noopener noreferrer" data-i18n="nav_wiki">Wiki ↗</a>
            <a href="#" class="nav-link" data-section="simuladores" data-i18n="nav_simuladores">Simuladores</a>
        </nav>

        <div class="navbar-actions">
            <label class="lang-switch" title="Cambiar idioma" aria-label="Cambiar idioma">
                <span class="ls-label ls-es">ES</span>
                <span class="ls-track"><span class="ls-thumb"></span></span>
                <span class="ls-label ls-en">EN</span>
            </label>
            <a href="https://github.com/whuera" target="_blank" rel="noopener noreferrer" class="nav-icon-btn" title="GitHub">
                <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                </svg>
            </a>
            <button class="nav-icon-btn admin-nav-btn" id="admin-btn" title="Admin">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
            </button>
            <button class="ai-btn" id="consultame-btn">
                <span class="ai-dot"></span>
                <span data-i18n="nav_ia_btn">IA Asistente</span>
            </button>
            <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Abrir menú" aria-expanded="false">
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
            </button>
        </div>
    </div>
</header>

<!-- ===== MOBILE MENU ===== -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav class="mobile-nav">
        <a href="#" class="mobile-nav-link active" data-section="inicio" data-i18n="nav_inicio">Inicio</a>
        <a href="#" class="mobile-nav-link" data-section="servicios" data-i18n="nav_servicios">Servicios</a>
        <a href="#" class="mobile-nav-link" data-section="plataforma" data-i18n="nav_plataforma">Plataforma ACI</a>
        <a href="https://deepwiki.com/whuera/switch_architecture" class="mobile-nav-link" target="_blank" rel="noopener noreferrer" data-i18n="nav_wiki">Wiki ↗</a>
        <a href="#" class="mobile-nav-link" data-section="simuladores" data-i18n="nav_simuladores">Simuladores</a>
    </nav>
    <div class="mobile-menu-footer">
        <label class="lang-switch" title="Cambiar idioma" aria-label="Cambiar idioma" style="margin-bottom:10px;">
            <span class="ls-label ls-es">ES</span>
            <span class="ls-track"><span class="ls-thumb"></span></span>
            <span class="ls-label ls-en">EN</span>
        </label>
        <button class="ai-btn mobile-ai-btn" id="mobile-consultame-btn">
            <span class="ai-dot"></span>
            <span data-i18n="nav_ia_btn">IA Asistente</span>
        </button>
    </div>
</div>

<!-- ===== MAIN CONTENT ===== -->
<main class="main">

    <!-- INICIO -->
    <section id="inicio-section" class="section active">
        <div class="section-inner">
            <div class="hero">
                <div class="hero-content">
                    <div class="hero-badge">
                        <span class="badge-dot"></span>
                        <span data-i18n="hero_badge">Consultora Especializada · ACI BASE24-eps / UPF</span>
                    </div>
                    <h1 class="hero-title">
                        <span data-i18n="hero_title">Expertos en</span>
                        <span class="gradient-text">ACI BASE24-eps</span>
                    </h1>
                    <p class="hero-desc" data-i18n="hero_desc1">
                        Consultoría especializada en diseño, arquitectura e implementación de soluciones
                        de pago basadas en la plataforma ACI BASE24-eps y UPF. Presencia en 7 países de
                        América Latina y Europa.
                    </p>
                    <p class="hero-desc hero-desc--cta" data-i18n="hero_desc2">
                        Si tienes un proyecto en marcha o estás evaluando una nueva implementación, estamos aquí para ayudarte. Nuestra misión es clara: acompañarte técnicamente en cada etapa y llevar tu solución a producción en el menor tiempo y al menor costo posible — sin comprometer la calidad ni la seguridad.
                    </p>
                    <div class="hero-stats">
                        <div class="stat-item">
                            <span class="stat-val">7+</span>
                            <span class="stat-label" data-i18n="stat_paises">Países</span>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat-item">
                            <span class="stat-val">100+</span>
                            <span class="stat-label" data-i18n="stat_proyectos">Proyectos</span>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat-item">
                            <span class="stat-val">10+</span>
                            <span class="stat-label" data-i18n="stat_anos">Años</span>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat-item stat-item--link" id="expertos-btn">
                            <span class="stat-val stat-val--accent">&#128100;</span>
                            <span class="stat-label" data-i18n="stat_expertos">Expertos</span>
                        </div>
                    </div>
                </div>
                <div class="hero-visual">
                    <div class="presence-card">
                        <div class="presence-header">
                            <span class="presence-dot"></span>
                            <span data-i18n="presence_global">Presencia Global</span>
                        </div>
                        <div class="world-map-wrap" id="world-map-wrap"></div>
                        <div class="country-legend">
                            <span class="country-dot latam"></span> Ecuador (×3) &nbsp;·&nbsp;
                            <span class="country-dot latam"></span> Colombia &nbsp;·&nbsp;
                            <span class="country-dot latam"></span> Panamá &nbsp;·&nbsp;
                            <span class="country-dot latam"></span> Costa Rica &nbsp;·&nbsp;
                            <span class="country-dot latam"></span> Chile &nbsp;·&nbsp;
                            <span class="country-dot latam"></span> Argentina &nbsp;·&nbsp;
                            <span class="country-dot eu"></span> España
                        </div>
                    </div>
                </div>
            </div>

            <div class="process-section">
                <p class="process-label" data-i18n="process_label">Metodología de Consultoría</p>
                <div class="process-flow">
                    <div class="process-card">
                        <div class="process-icon">&#128270;</div>
                        <div class="process-name" data-i18n="process_diag_name">Diagnóstico</div>
                        <div class="process-desc" data-i18n="process_diag_desc">Análisis &amp; Levantamiento</div>
                        <div class="process-buttons" style="display:flex;gap:8px;margin-top:10px;">
                            <button id="validacion-btn" class="process-btn" data-i18n="process_diag_btn">Metodología</button>
                        </div>
                    </div>
                    <div class="process-arrow">
                        <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M4 11H18M18 11L12 5M18 11L12 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="process-card">
                        <div class="process-icon">&#128208;</div>
                        <div class="process-name" data-i18n="process_diseno_name">Diseño</div>
                        <div class="process-desc" data-i18n="process_diseno_desc">Arquitectura &amp; Solución</div>
                        <div class="process-buttons" style="display:flex;gap:8px;margin-top:10px;">
                            <button id="enrutamiento-btn" class="process-btn" data-i18n="process_diseno_btn">Metodología</button>
                            <a href="https://viewdiagram-git-master-whueras-projects.vercel.app/" target="_blank" rel="noopener noreferrer" class="process-btn" data-i18n="process_diseno_diag">Diagramas</a>
                        </div>
                    </div>
                    <div class="process-arrow">
                        <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M4 11H18M18 11L12 5M18 11L12 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="process-card">
                        <div class="process-icon">&#128295;</div>
                        <div class="process-name" data-i18n="process_impl_name">Implementación</div>
                        <div class="process-desc" data-i18n="process_impl_desc">Configuración &amp; Go-Live</div>
                        <div class="process-buttons" style="display:flex;gap:8px;margin-top:10px;">
                            <button id="autorizacion-btn" class="process-btn" data-i18n="process_impl_btn">Metodología</button>
                            <button id="proyectos-btn" class="process-btn" data-i18n="process_impl_proj">Nuestros Proyectos</button>
                        </div>
                    </div>
                    <div class="process-arrow">
                        <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M4 11H18M18 11L12 5M18 11L12 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="process-card">
                        <div class="process-icon">&#128101;</div>
                        <div class="process-name" data-i18n="process_soporte_name">Soporte</div>
                        <div class="process-desc" data-i18n="process_soporte_desc">Mantenimiento &amp; Evolución</div>
                        <div class="process-buttons" style="display:flex;gap:8px;margin-top:10px;">
                            <button id="journal-btn" class="process-btn" data-i18n="process_soporte_btn">Metodología</button>
                        </div>
                    </div>
                    <div class="price-separator">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                    <div class="process-card prices-card" id="prices-btn">
                        <div class="process-icon">&#128176;</div>
                        <div class="process-name" data-i18n="process_tarifas_name">Tarifas</div>
                        <div class="process-desc" data-i18n="process_tarifas_desc">Servicios &amp; Costos</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SERVICIOS -->
    <section id="servicios-section" class="section hidden">
        <div class="section-inner">
            <div class="section-header">
                <h2 class="section-title"><span data-i18n="servicios_title">Nuestros</span> <span class="gradient-text" data-i18n="servicios_title2">Servicios</span></h2>
                <p class="section-desc" data-i18n="servicios_desc">Ofrecemos consultoría integral en todas las fases del ciclo de vida de soluciones ACI BASE24-eps y UPF, desde el diseño hasta la operación.</p>
            </div>

            <div class="content-card">
                <div class="card-image" style="background-image: url('/images/arquitectura-diagram.png');"></div>
                <div class="card-body">
                    <span class="card-tag" data-i18n="serv_main_tag">Servicio Principal</span>
                    <h3 data-i18n="serv_main_title">Arquitectura de Soluciones de Pago</h3>
                    <p data-i18n="serv_main_desc">Diseño y documentación de arquitecturas transaccionales de alta disponibilidad sobre la plataforma ACI BASE24-eps, incluyendo integración con redes internacionales y core bancario.</p>
                </div>
            </div>

            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">&#128270;</div>
                    <h3 data-i18n="serv_f1_title">Consultoría Técnica</h3>
                    <p data-i18n="serv_f1_desc">Levantamiento, análisis y diagnóstico de plataformas BASE24-eps existentes para identificar brechas y oportunidades</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">&#128200;</div>
                    <h3 data-i18n="serv_f2_title">Implementación UPF</h3>
                    <p data-i18n="serv_f2_desc">Diseño e implementación de flujos de pago modernos sobre ACI Universal Payments Framework</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">&#128274;</div>
                    <h3 data-i18n="serv_f3_title">Seguridad &amp; HSM</h3>
                    <p data-i18n="serv_f3_desc">Configuración de módulos HSM, criptografía EMV, gestión de llaves y cumplimiento PCI-DSS</p>
                </div>
                <div class="feature-card feature-card--clickable" id="formacion-btn" role="button" tabindex="0" title="Ver programas de formación">
                    <div class="feature-icon">&#128101;</div>
                    <h3 data-i18n="serv_f4_title">Transferencia de Conocimiento</h3>
                    <p data-i18n="serv_f4_desc">Capacitación de equipos técnicos locales en arquitectura, operación y mantenimiento de la plataforma</p>
                    <span class="feature-cta" data-i18n="serv_f4_cta">Ver programas →</span>
                </div>
            </div>

            <!-- Capacidades Extendidas -->
            <div class="ext-services-header">
                <span class="ext-services-label" data-i18n="serv_ext_label">Capacidades Adicionales</span>
            </div>

            <div class="ext-services-grid">

                <!-- IA & Data Science -->
                <div class="ext-card ext-card--ai">
                    <div class="ext-card-top">
                        <div class="ext-card-icon">
                            <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                                <circle cx="24" cy="24" r="22" stroke="url(#ai-grad)" stroke-width="1.5" fill="rgba(139,92,246,0.08)"/>
                                <circle cx="24" cy="14" r="3.5" fill="#a78bfa"/>
                                <circle cx="14" cy="30" r="3.5" fill="#a78bfa"/>
                                <circle cx="34" cy="30" r="3.5" fill="#a78bfa"/>
                                <circle cx="24" cy="24" r="5" fill="url(#ai-grad)" opacity="0.9"/>
                                <line x1="24" y1="17.5" x2="24" y2="19" stroke="#a78bfa" stroke-width="1.5"/>
                                <line x1="16.5" y1="28" x2="21" y2="25.5" stroke="#a78bfa" stroke-width="1.5"/>
                                <line x1="31.5" y1="28" x2="27" y2="25.5" stroke="#a78bfa" stroke-width="1.5"/>
                                <circle cx="10" cy="20" r="2.5" fill="#7c3aed" opacity="0.6"/>
                                <circle cx="38" cy="20" r="2.5" fill="#7c3aed" opacity="0.6"/>
                                <circle cx="24" cy="38" r="2.5" fill="#7c3aed" opacity="0.6"/>
                                <line x1="12" y1="21" x2="21" y2="23" stroke="#7c3aed" stroke-width="1" opacity="0.5"/>
                                <line x1="36" y1="21" x2="27" y2="23" stroke="#7c3aed" stroke-width="1" opacity="0.5"/>
                                <line x1="24" y1="35.5" x2="24" y2="29" stroke="#7c3aed" stroke-width="1" opacity="0.5"/>
                                <defs>
                                    <linearGradient id="ai-grad" x1="0" y1="0" x2="48" y2="48" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#8b5cf6"/>
                                        <stop offset="1" stop-color="#6366f1"/>
                                    </linearGradient>
                                </defs>
                            </svg>
                        </div>
                        <div class="ext-card-badge ext-badge--ai">IA &amp; Data</div>
                    </div>
                    <h3 data-i18n="serv_ai_title">Inteligencia Artificial &amp; Data Science</h3>
                    <p data-i18n="serv_ai_desc">Diseño e implementación de soluciones de IA y ciencia de datos aplicadas a la industria financiera: modelos predictivos, detección de fraude, análisis de transacciones y pipelines de datos para toma de decisiones en tiempo real.</p>
                    <div class="ext-tech-stack">
                        <span class="ext-tech">Python</span>
                        <span class="ext-tech">TensorFlow</span>
                        <span class="ext-tech">Scikit-learn</span>
                        <span class="ext-tech">LLM / RAG</span>
                        <span class="ext-tech">ETL Pipelines</span>
                        <span class="ext-tech">ML Ops</span>
                    </div>
                    <button class="ext-price-btn ext-price-btn--ai" data-price-node="consulting">
                        <span data-i18n="serv_price_btn">Ver tarifa</span>
                        <span class="ext-price-pill">$35<span>/hr</span></span>
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>

                <!-- Java & Cloud -->
                <div class="ext-card ext-card--java">
                    <div class="ext-card-top">
                        <div class="ext-card-icon">
                            <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                                <!-- Java cup -->
                                <path d="M16 12 C15 18 13 20 14 26 C15 31 20 34 24 34 C28 34 33 31 34 26 C35 20 33 18 32 12 Z" stroke="url(#java-grad)" stroke-width="1.5" fill="rgba(234,88,12,0.08)"/>
                                <path d="M18 22 C18 22 17 24 19 25 C22 26 26 26 29 25 C31 24 30 22 30 22" stroke="#fb923c" stroke-width="1.2" fill="none" stroke-linecap="round"/>
                                <!-- Cloud -->
                                <path d="M8 38 C8 35 10 33 13 33 C13.5 30.5 16 29 19 30 C20 28 22 27 24.5 28 C27 25 31 25 33 28 C36 28 38 30 38 33 C40 33.5 41 35 41 37 C41 39.5 39 41 37 41 L11 41 C9 41 8 40 8 38 Z" fill="url(#java-cloud)" opacity="0.85"/>
                                <defs>
                                    <linearGradient id="java-grad" x1="16" y1="12" x2="32" y2="34" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#f97316"/>
                                        <stop offset="1" stop-color="#fb923c"/>
                                    </linearGradient>
                                    <linearGradient id="java-cloud" x1="8" y1="27" x2="41" y2="41" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#0ea5e9"/>
                                        <stop offset="1" stop-color="#6366f1"/>
                                    </linearGradient>
                                </defs>
                            </svg>
                        </div>
                        <div class="ext-card-badge ext-badge--java">Java &amp; Cloud</div>
                    </div>
                    <h3 data-i18n="serv_java_title">Desarrollo Java &amp; Soluciones Cloud</h3>
                    <p data-i18n="serv_java_desc">Arquitectura y desarrollo de aplicaciones empresariales con Java y Spring Boot, integradas en entornos cloud de alta disponibilidad. Implementación de microservicios, APIs REST, contenedores y despliegues en las principales plataformas cloud del mercado.</p>
                    <div class="ext-tech-stack">
                        <span class="ext-tech">Java</span>
                        <span class="ext-tech">Spring Boot</span>
                        <span class="ext-tech">Microservicios</span>
                        <span class="ext-tech ext-tech--aws">AWS</span>
                        <span class="ext-tech ext-tech--gcp">GCP</span>
                        <span class="ext-tech ext-tech--azure">Azure</span>
                        <span class="ext-tech">Docker / K8s</span>
                    </div>
                    <button class="ext-price-btn ext-price-btn--java" data-price-node="design">
                        <span data-i18n="serv_price_btn">Ver tarifa</span>
                        <span class="ext-price-pill">$30<span>/hr</span></span>
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>

                <!-- PowerBuilder -->
                <div class="ext-card ext-card--pb">
                    <div class="ext-card-top">
                        <div class="ext-card-icon">
                            <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                                <!-- Window frame -->
                                <rect x="6" y="9" width="36" height="30" rx="4" stroke="url(#pb-grad)" stroke-width="1.5" fill="rgba(234,179,8,0.06)"/>
                                <!-- Title bar -->
                                <rect x="6" y="9" width="36" height="9" rx="4" fill="url(#pb-grad)" opacity="0.35"/>
                                <rect x="8" y="9" width="34" height="5" fill="url(#pb-grad)" opacity="0.35"/>
                                <!-- Dots -->
                                <circle cx="11" cy="13.5" r="1.5" fill="#facc15"/>
                                <circle cx="16" cy="13.5" r="1.5" fill="#fbbf24" opacity="0.7"/>
                                <circle cx="21" cy="13.5" r="1.5" fill="#f59e0b" opacity="0.5"/>
                                <!-- PB text -->
                                <text x="24" y="31" font-family="monospace" font-size="13" font-weight="800" fill="url(#pb-grad)" text-anchor="middle" letter-spacing="-0.5">PB</text>
                                <defs>
                                    <linearGradient id="pb-grad" x1="6" y1="9" x2="42" y2="39" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#eab308"/>
                                        <stop offset="1" stop-color="#f97316"/>
                                    </linearGradient>
